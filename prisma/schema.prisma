generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Profile {
  id Int @id @default(1)
  name String @default("")
  role String @default("")
  headline String @default("")
  intro String @default("")
  bio String @default("")
  photo String @default("")
  photo2 String @default("")
  cvUrl String @default("")
  email String @default("")
  phone String @default("")
  location String @default("")
  linkedin String @default("")
  github String @default("")
  pills String[]
  stats String[]
}
model Skill {
  id Int @id @default(autoincrement())
  category String
  items String[]
  order Int @default(0)
}
model Entry {
  id Int @id @default(autoincrement())
  kind String
  title String
  org String @default("")
  place String @default("")
  period String @default("")
  details String @default("")
  order Int @default(0)
}
model Project {
  id Int @id @default(autoincrement())
  slug String @unique
  title String
  summary String @default("")
  details String @default("")
  cover String @default("")
  images String[]
  tech String[]
  liveUrl String @default("")
  repoUrl String @default("")
  order Int @default(0)
}
model Certification {
  id Int @id @default(autoincrement())
  title String
  issuer String @default("")
  date String @default("")
  image String @default("")
  url String @default("")
  order Int @default(0)
}
model Message {
  id Int @id @default(autoincrement())
  name String
  email String
  body String
  createdAt DateTime @default(now())
}
